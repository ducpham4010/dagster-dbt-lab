POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dbt
POSTGRES_PASSWORD=dbt
POSTGRES_DB=jaffle_shop

# Apache Doris FE, MySQL protocol (FE query_port, not the HTTP port)
DORIS_HOST=192.168.102.4
DORIS_PORT=19030
DORIS_USER=root
DORIS_PASSWORD=
# Doris has no schema level: this database holds both the raw tables (Python assets) and dbt models
DORIS_SCHEMA=superapp_semantic
# Replicas per table; 1 for a single-BE lab cluster (Doris default is 3)
DORIS_REPLICATION_NUM=1
